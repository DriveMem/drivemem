{
  "name": "drivemem-desktop",
  "version": "0.1.0",
  "description": "DriveMem Desktop — AI Memory Layer",
  "author": "DriveMem <hello@drivemem.cloud>",
  "repository": {
    "type": "git",
    "url": "https://github.com/yufuche1/ai-drive.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "cloud.drivemem.desktop",
    "productName": "DriveMem",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
