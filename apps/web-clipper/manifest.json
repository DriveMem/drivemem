{
  "manifest_version": 3,
  "name": "AI Drive Web Clipper",
  "version": "1.0.0",
  "description": "一键保存网页内容到 AI Drive",
  "permissions": ["contextMenus", "activeTab", "storage", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icon48.png" },
  "icons": { "48": "icon48.png", "128": "icon128.png" }
}
