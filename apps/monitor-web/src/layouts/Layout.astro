---
interface Props {
  title?: string;
}

const { title = 'AI Drive Monitor' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AI Drive Multi-Agent Monitor" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-page text-primary font-sans min-h-screen flex flex-col pb-16 sm:pb-0">
    <header class="sticky top-0 z-50 border-b border-neutral-200/60 bg-white/80 backdrop-blur-lg">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-12 sm:h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <span class="text-lg sm:text-xl">🦞</span>
          <span class="text-base sm:text-lg font-bold tracking-tight bg-gradient-to-r from-brand-600 to-brand-500 bg-clip-text text-transparent">龙虾监控站</span>
        </a>
        <div class="hidden sm:flex items-center gap-1 sm:gap-2 text-sm">
          <a
            href="/"
            class:list={[
              'px-3 py-1.5 rounded-lg transition-colors',
              currentPath === '/' ? 'bg-brand-50 text-brand-600 font-medium' : 'text-secondary hover:text-primary hover:bg-hover',
            ]}
          >Dashboard</a>
          <a
            href={`/memory/${new Date().toISOString().slice(0, 10)}`}
            class:list={[
              'px-3 py-1.5 rounded-lg transition-colors',
              currentPath.startsWith('/memory') ? 'bg-brand-50 text-brand-600 font-medium' : 'text-secondary hover:text-primary hover:bg-hover',
            ]}
          >Memory</a>
        </div>
      </nav>
    </header>

    <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 w-full">
      <slot />
    </main>

    <footer class="hidden sm:block border-t border-neutral-200/60 py-4 sm:py-6">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between text-xs text-tertiary">
        <span>AI Drive Monitor</span>
        <span>Multi-Agent System</span>
      </div>
    </footer>

    <!-- Mobile bottom tab bar -->
    <nav class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-t border-neutral-200/60 flex items-center justify-around h-16 safe-area-bottom" style="position:fixed;bottom:0;left:0;right:0;z-index:9999">>
      <a
        href="/"
        class:list={[
          'flex flex-col items-center gap-1 px-4 py-2 rounded-lg transition-colors min-w-[64px]',
          currentPath === '/' || currentPath.startsWith('/agent') ? 'text-brand-600' : 'text-tertiary',
        ]}
      >
        <span class="text-xl">🏠</span>
        <span class="text-[10px] font-medium">Dashboard</span>
      </a>
      <a
        href={`/memory/${new Date().toISOString().slice(0, 10)}`}
        class:list={[
          'flex flex-col items-center gap-1 px-4 py-2 rounded-lg transition-colors min-w-[64px]',
          currentPath.startsWith('/memory') ? 'text-brand-600' : 'text-tertiary',
        ]}
      >
        <span class="text-xl">📝</span>
        <span class="text-[10px] font-medium">Memory</span>
      </a>
    </nav>
  </body>
</html>
