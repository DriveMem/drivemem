---
interface Props {
  title?: string;
}

const { title = 'AI Drive Monitor' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AI Drive Multi-Agent Monitor" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="bg-page text-primary font-sans min-h-screen flex flex-col">
    <header class="border-b border-gray-200 bg-card">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-12 sm:h-14 flex items-center justify-between">
        <a href="/" class="text-base sm:text-lg font-semibold tracking-tight">🦞 龙虾监控站</a>
        <div class="flex items-center gap-4 sm:gap-6 text-sm text-secondary">
          <a href="/" class="hover:text-primary transition-colors">Dashboard</a>
          <a href={`/memory/${new Date().toISOString().slice(0, 10)}`} class="hover:text-primary transition-colors">Memory</a>
        </div>
      </nav>
    </header>

    <main class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 w-full">
      <slot />
    </main>

    <footer class="border-t border-gray-200 py-4 text-center text-xs text-tertiary">
      AI Drive Monitor · Multi-Agent System
    </footer>
  </body>
</html>
