---
import Layout from '@/layouts/Layout.astro';
import MemoryBrowser from '@/components/MemoryBrowser';

export function getStaticPaths() {
  return [
    { params: { date: 'today' } },
    { params: { date: '2026-04-01' } },
    { params: { date: '2026-03-31' } },
  ];
}
const { date } = Astro.params;
---

<Layout title={`Memory · ${date} · 龙虾监控站`}>
  <div class="mb-6">
    <a href="/" class="text-sm text-secondary hover:text-primary transition-colors">← Dashboard</a>
  </div>
  <h1 class="text-2xl font-semibold mb-6">Memory Browser</h1>
  <MemoryBrowser initialDate={date === 'today' ? '' : date ?? ''} client:load />
</Layout>
