---
import Layout from '@/layouts/Layout.astro';
import MemoryViewer from '@/components/MemoryViewer';
import DatePicker from '@/components/DatePicker';

const { date } = Astro.params;

export function getStaticPaths() {
  return [
    { params: { date: 'today' } },
    { params: { date: '2026-04-01' } },
  ];
}
---

<Layout title={`Memory · ${date} · AI Drive Monitor`}>
  <div class="mb-6">
    <a href="/" class="text-sm text-secondary hover:text-primary transition-colors">← Dashboard</a>
  </div>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-semibold">Memory Browser</h1>
    <DatePicker value={date ?? ''} client:load />
  </div>
  <MemoryViewer date={date ?? ''} entries={[]} client:load />
</Layout>
